# Salin ke .env lalu isi. Jangan pernah commit berkas .env atau salinannya:
# .gitignore menyapu .env* dan hanya mengecualikan berkas contoh ini.

# Server
PORT=3000
NODE_ENV=development

# Alamat frontend. Dipakai whitelist CORS REST dan kedua gateway WebSocket.
# Boleh beberapa alamat dipisah koma. Tanpa garis miring di akhir.
FRONTEND_URL=http://localhost:3001

# Alamat yang dipakai menyusun tautan di dalam email. Umumnya sama dengan FRONTEND_URL.
APP_URL=http://localhost:3001

# Postgres Supabase. Pakai mode Session pooler, bukan koneksi langsung:
# koneksi langsung hanya menyediakan IPv6 dan tidak terjangkau dari Railway.
DATABASE_URL=

# Supabase, untuk penyimpanan berkas
SUPABASE_URL=
# Service role key melewati seluruh aturan row level security.
# Hanya boleh ada di server, tidak pernah di frontend.
SUPABASE_SERVICE_ROLE_KEY=

# JWT. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Jalankan dua kali: kedua nilai harus berbeda.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=60m
JWT_REFRESH_EXPIRES_IN=7d

# Xendit
XENDIT_SECRET_KEY=
# Diperiksa terhadap header x-callback-token di kedua endpoint webhook.
XENDIT_CALLBACK_TOKEN=

# Resend. Domain EMAIL_FROM harus sudah terverifikasi di Resend.
RESEND_API_KEY=
EMAIL_FROM="StairsLife <noreply@contoh.id>"

# Penarikan dana, dalam rupiah
WITHDRAWAL_MIN_AMOUNT=50000
WITHDRAWAL_ADMIN_FEE=2500
